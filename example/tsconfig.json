{
	"compilerOptions": {
		"moduleResolution": "Bundler",
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ESNext", "DOM"],
		"removeComments": true,
		"strict": true,
		"sourceMap": true,
		"declaration": true,
		"declarationDir": "./dist",
		"rootDir": "..",
		"outDir": "./dist"
	},
	"include": ["**/*"],
	"exclude": ["node_modules", "dist"]
}
